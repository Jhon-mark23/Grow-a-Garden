    -- ========== AUTO HEAL ==========
    function findTool(name)
        name = tostring(name or ""):lower()
        local ch = LocalPlayer.Character
        for _, root in { ch, LocalPlayer:FindFirstChild("Backpack") } do
            if root then
                for _, obj in ipairs(root:GetChildren()) do
                    if obj:IsA("Tool") and obj.Name:lower():find(name, 1, true) then
                        return obj
                    end
                end
            end
        end
        return nil
    end
    function equipTool(tool)
        if not tool or not tool:IsA("Tool") then return false end
        local ch = LocalPlayer.Character
        if ch and tool:IsDescendantOf(ch) then return true end
        if st.healAutoEquip ~= true then return false end
        local hum = ch and ch:FindFirstChild("Humanoid")
        if not hum then return false end
        return pcall(function() hum:EquipTool(tool) end)
    end
    function firstAidReady(tool)
        if not tool or not tool.Parent then return false end
        if tool:FindFirstChild("Done") and tool:FindFirstChild("Done").Value == true then return false end
        if tool:FindFirstChild("Doing") and tool:FindFirstChild("Doing").Value == true then return false end
        local uses = tool:FindFirstChild("Uses")
        if uses and tonumber(uses.Value) and tonumber(uses.Value) <= 0 then return false end
        return true
    end
    function fireFirstAid(target)
        local tool = findTool("firstaid") or findTool("first aid")
        if not firstAidReady(tool) then return false end
        equipTool(tool)
        local ev = tool:FindFirstChild("RemoteEvent")
        if ev and ev:IsA("RemoteEvent") then
            if target then
                return pcall(function() ev:FireServer("HealPlrStart", target) end)
            end
            return pcall(function() ev:FireServer("YourselfStart") end)
        end
        if not target then
            return pcall(function() tool:Activate() end)
        end
        return false
    end
    function getHealTarget()
        local ch = LocalPlayer.Character
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        if not ch or not root then return nil end
        local best, dist = nil, 5
        for _, plr in ipairs(Players:GetPlayers()) do
            local tc = plr.Character
            if tc and tc ~= ch then
                local hum = tc:FindFirstChild("Humanoid")
                local hrp = tc:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 and hum.MaxHealth > 0 and hum.Health < hum.MaxHealth then
                    local pct = hum.Health / hum.MaxHealth * 100
                    local mag = (root.Position - hrp.Position).Magnitude
                    if pct <= (tonumber(st.healPlayerAt) or 60) and mag < dist then
                        dist = mag
                        best = tc
                    end
                end
            end
        end
        return best
    end
    function autoFirstAid()
        if st.autoHealSelf ~= true and st.autoHealPlayers ~= true then return false end
        if time() - (st.lastHealT or 0) < 7.5 then return false end
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 or hum.MaxHealth <= 0 then return false end
        if st.autoHealSelf == true and hum.Health < hum.MaxHealth and hum.Health / hum.MaxHealth * 100 <= (tonumber(st.healSelfAt) or 55) then
            if fireFirstAid(nil) then
                st.lastHealT = time()
                return true
            end
        end
        if st.autoHealPlayers == true then
            local target = getHealTarget()
            if target and fireFirstAid(target) then
                st.lastHealT = time()
                return true
            end
        end
        return false
    end

    -- ========== POWER RESTORATION WITH TELEPORT ==========
    local powerRepairBusy = false
    local POWER_STATION_POSITION = Vector3.new(-285, 19, -210)
    
    function teleportToPowerStation()
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then
            notify("Error", "Character not found!", 2)
            return false
        end
        
        root.CFrame = CFrame.new(POWER_STATION_POSITION + Vector3.new(0, 5, 0))
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        
        notify("Teleport", "Teleported to Power Station!", 2)
        return true
    end
    
    function repairPowerStation()
        if powerRepairBusy == true then 
            notify("Power Station", "Repair already in progress!", 2)
            return false, "busy" 
        end
        
        local map = Workspace:FindFirstChild("Map")
        local powerStation = map and map:FindFirstChild("PowerStation")
        local station = powerStation and powerStation:FindFirstChild("StationFolder")
        local guiPart = station and station:FindFirstChild("StationGUIPart")
        local prompt = guiPart and guiPart:FindFirstChildWhichIsA("ProximityPrompt")
        local ev = station and station:FindFirstChild("RemoteEvent")
        local progress = station and station:FindFirstChild("Progress")
        local stationPower = ReplicatedStorage:FindFirstChild("StationPower")
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        
        if not (station and guiPart and prompt and ev and root and hum) then
            notify("Error", "Power station components not found!", 3)
            return false, "missing"
        end
        
        if stationPower and stationPower.Value == true then
            notify("Power Station", "Power is already online!", 2)
            return true, "powered"
        end
        
        if st.teleportToPower then
            teleportToPowerStation()
            task.wait(0.5)
        end
        
        powerRepairBusy = true
        local oldCf = root.CFrame
        local oldAnchored = root.Anchored
        
        notify("Power Station", "Starting power restoration...", 2)
        
        local ok, result = pcall(function()
            -- Use direct StationStart as requested
            ev:FireServer("StationStart")
            
            local activate = tonumber(prompt:GetAttribute("ActivateTime")) or 30
            local deadline = time() + math.max(activate + 8, 35)
            local success = false
            
            local maxWait = st.stayUntilPowered and 120 or 45
            local waitDeadline = time() + maxWait
            
            while root.Parent and time() < deadline and time() < waitDeadline do
                if stationPower and stationPower.Value == true then
                    success = true
                    break
                end
                if progress and tonumber(progress.Value) and progress.Value >= 100 then
                    success = true
                    break
                end
                task.wait(0.25)
            end
            
            if not success then
                pcall(function() ev:FireServer("StationCancel") end)
            end
            
            return success
        end)
        
        pcall(function()
            root.Anchored = oldAnchored
            root.CFrame = oldCf
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        
        powerRepairBusy = false
        
        if ok and result == true then
            notify("✅ Power Station", "Power restoration completed successfully!", 3)
            return true, "done"
        else
            notify("❌ Power Station", "Power restoration failed or timed out!", 3)
            return false, "timeout"
        end
    end
    
    function autoRestorePower()
        if st.autoPowerRestore ~= true or powerRepairBusy == true then return false end
        local stationPower = ReplicatedStorage:FindFirstChild("StationPower")
        if not stationPower or stationPower.Value == true then return false end
        task.spawn(function() repairPowerStation() end)
        return true
    end

