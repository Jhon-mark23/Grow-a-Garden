    -- ========== AUTO HEAL ==========
    function findTool(name)
        name = tostring(name or ""):lower()
        local lp = Plrs.LocalPlayer
        local ch = getChar()
        for _, root in { ch, lp and ffc(lp, "Backpack") } do
            if root then
                for _, obj in kids(root) do
                    if obj:IsA("Tool") and obj.Name:lower():find(name, 1, true) then
                        return obj
                    end
                end
            end
        end
        return nil
    end
    function equipTool(tool)
        if not tool or not tool:IsA("Tool") then return false end
        local ch = getChar()
        if ch and tool:IsDescendantOf(ch) then return true end
        if st.healAutoEquip ~= true then return false end
        local hum = getHum()
        if not hum then return false end
        return pcall(function() hum:EquipTool(tool) end)
    end
    function firstAidReady(tool)
        if not tool or not tool.Parent then return false end
        if valOf(ffc(tool, "Done"), false) == true or valOf(ffc(tool, "Doing"), false) == true then
            return false
        end
        local uses = ffc(tool, "Uses")
        if uses and tonumber(valOf(uses, 1)) and tonumber(valOf(uses, 1)) <= 0 then
            return false
        end
        return true
    end
    function fireFirstAid(target)
        local tool = findTool("firstaid") or findTool("first aid")
        if not firstAidReady(tool) then return false end
        equipTool(tool)
        local ev = ffc(tool, "RemoteEvent")
        if ev and ev:IsA("RemoteEvent") then
            if target then
                return pcall(function() ev:FireServer("HealPlrStart", target) end)
            end
            return pcall(function() ev:FireServer("YourselfStart") end)
        end
        if not target then
            return pcall(function() tool:Activate() end)
        end
        return false
    end
    function getHealTarget()
        local ch = getChar()
        local root = GET_HRP()
        if not ch or not root then return nil end
        local best, dist = nil, 5
        for _, plr in kids(Plrs) do
            local tc = plr.Character
            if tc and tc ~= ch then
                local hum = ffc(tc, "Humanoid")
                local hrp = ffc(tc, "HumanoidRootPart")
                if hum and hrp and hum.Health > 0 and hum.MaxHealth > 0 and hum.Health < hum.MaxHealth then
                    local pct = hum.Health / hum.MaxHealth * 100
                    local mag = (root.Position - hrp.Position).Magnitude
                    if pct <= (tonumber(st.healPlayerAt) or 60) and mag < dist then
                        dist = mag
                        best = tc
                    end
                end
            end
        end
        return best
    end
    function autoFirstAid()
        if st.autoHealSelf ~= true and st.autoHealPlayers ~= true then return false end
        if time() - (st.lastHealT or 0) < 7.5 then return false end
        local hum = getHum()
        if not hum or hum.Health <= 0 or hum.MaxHealth <= 0 then return false end
        if st.autoHealSelf == true and hum.Health < hum.MaxHealth and hum.Health / hum.MaxHealth * 100 <= (tonumber(st.healSelfAt) or 55) then
            if fireFirstAid(nil) then
                st.lastHealT = time()
                return true
            end
        end
        if st.autoHealPlayers == true then
            local target = getHealTarget()
            if target and fireFirstAid(target) then
                st.lastHealT = time()
                return true
            end
        end
        return false
    end

    -- ========== POWER RESTORATION ==========
    local powerRepairBusy = false
    function repairPowerStation()
        if powerRepairBusy == true then return false, "busy" end
        local map = ffc(Ws, "Map")
        local powerStation = map and ffc(map, "PowerStation")
        local station = powerStation and ffc(powerStation, "StationFolder")
        local guiPart = station and ffc(station, "StationGUIPart")
        local prompt = guiPart and ffc(guiPart, "ProximityPrompt")
        local ev = station and ffc(station, "RemoteEvent")
        local progress = station and ffc(station, "Progress")
        local stationPower = ffc(Rep, "StationPower")
        local root = GET_HRP()
        local hum = getHum()
        local ch = getChar()
        if not (station and guiPart and prompt and ev and root and hum and ch) then
            return false, "missing"
        end
        if stationPower and stationPower.Value == true then
            return true, "powered"
        end
        powerRepairBusy = true
        local oldCf = root.CFrame
        local oldAnchored = root.Anchored
        local ok, result = pcall(function()
            local useToolbox = false
            if st.powerRestoreUseToolbox == true then
                local toolbox = findTool("toolbox")
                if toolbox then
                    pcall(function() hum:EquipTool(toolbox) end)
                    task.wait(0.15)
                    useToolbox = toolbox.Parent == ch
                end
            end
            root.CFrame = guiPart.CFrame * CFrame.new(0,0,3)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.2)
            root.Anchored = true
            ev:FireServer("StationStart", useToolbox)
            local activate = tonumber(prompt:GetAttribute("ActivateTime")) or 30
            local deadline = time() + math.max(activate + 8, 35)
            local success = false
            while AllowRunService == true and root.Parent and time() < deadline do
                if stationPower and stationPower.Value == true then
                    success = true
                    break
                end
                if progress and tonumber(progress.Value) and progress.Value >= 100 then
                    success = true
                    break
                end
                task.wait(0.25)
            end
            if not success then
                pcall(function() ev:FireServer("StationCancel") end)
            end
            return success
        end)
        pcall(function()
            root.Anchored = oldAnchored
            root.CFrame = oldCf
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        powerRepairBusy = false
        return ok and result == true, ok and (result == true and "done" or "timeout") or tostring(result)
    end
    function autoRestorePower()
        if st.autoPowerRestore ~= true or powerRepairBusy == true then
            return false
        end
        local stationPower = ffc(Rep, "StationPower")
        if not stationPower or stationPower.Value == true then
            return false
        end
        task.spawn(function()
            repairPowerStation()
        end)
        return true
    end

    -- ========== BRING ITEMS ==========
    function bringItems(type)
        local cf = GET_HRP()
        if not cf then
            notify("Error", "Character not found!", 2)
            return 0
        end
        local count = 0
        if type == "scraps" then
            local filter = Ws:FindFirstChild("Filter")
            local root = filter and filter:FindFirstChild("ScrapSpawns") or Ws
            local function isInCharacter(obj)
                for _, plr in Plrs:GetPlayers() do
                    local ch = plr.Character
                    if ch and obj:IsDescendantOf(ch) then
                        return true
                    end
                end
                return false
            end
            for _, obj in desc(root) do
                if obj.Name:lower() == "scrap" and obj:IsA("BasePart") and not isInCharacter(obj) then
                    pcall(function()
                        obj.CFrame = cf.CFrame * CFrame.new((count % 5) * 1.5, 1.5 + math.floor(count / 5) * 0.35, 0)
                        obj.AssemblyLinearVelocity = Vector3.zero
                        obj.AssemblyAngularVelocity = Vector3.zero
                    end)
                    count = count + 1
                end
            end
        elseif type == "flaregun" then
            local flaregun = ffcr(Ws, "FlareGunPickUp")
            if not flaregun then
                for _, obj in desc(Ws) do
                    if obj:IsA("BasePart") and obj.Name:lower():find("flaregun") then
                        flaregun = obj
                        break
                    end
                end
            end
            if flaregun then
                pcall(function()
                    if flaregun:IsA("BasePart") then
                        flaregun.CFrame = cf.CFrame * CFrame.new(0, 1.5, 0)
                        flaregun.AssemblyLinearVelocity = Vector3.zero
                        flaregun.AssemblyAngularVelocity = Vector3.zero
                    elseif flaregun:IsA("Model") then
                        flaregun:PivotTo(cf.CFrame * CFrame.new(0, 1.5, 0))
                    end
                    count = 1
                end)
            end
        end
        return count
    end

