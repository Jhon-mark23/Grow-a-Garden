    local SpawnNotifier = {
        notifiedScraps = {},
        notifiedFlareguns = {},
        active = true,
        lastNotification = 0,
        cooldown = 2,
    }
    function SpawnNotifier:notifyScrap(scrap)
        if not self.active then return end
        local id = tostring(scrap)
        if self.notifiedScraps[id] then return end
        if time() - self.lastNotification < self.cooldown then
            task.wait(self.cooldown - (time() - self.lastNotification))
        end
        self.notifiedScraps[id] = true
        self.lastNotification = time()
        notify("🔧 Scrap Spawned!", "A scrap has appeared!", 3, true)
        task.delay(60, function() self.notifiedScraps[id] = nil end)
    end
    function SpawnNotifier:notifyFlaregun(flaregun)
        if not self.active then return end
        local id = tostring(flaregun)
        if self.notifiedFlareguns[id] then return end
        if time() - self.lastNotification < self.cooldown then
            task.wait(self.cooldown - (time() - self.lastNotification))
        end
        self.notifiedFlareguns[id] = true
        self.lastNotification = time()
        notify("🔫 Flaregun Spawned!", "A flaregun has appeared!", 3, true)
        task.delay(60, function() self.notifiedFlareguns[id] = nil end)
    end
    function SpawnNotifier:startListening()
        Workspace.DescendantAdded:Connect(function(obj)
            if isCollectibleScrap(obj) then
                self:notifyScrap(obj)
            end
            if isRealFlareGun(obj) then
                self:notifyFlaregun(obj)
            end
        end)
        task.delay(2, function()
            local filter = Workspace:FindFirstChild("Filter")
            local scrapRoot = filter and filter:FindFirstChild("ScrapSpawns")
            if scrapRoot then
                for _, obj in ipairs(scrapRoot:GetDescendants()) do
                    if isCollectibleScrap(obj) then
                        self:notifyScrap(obj)
                    end
                end
            end
            local fl = Workspace:FindFirstChild("FlareGunPickUp", true)
            if not fl then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if isRealFlareGun(obj) then
                        fl = obj
                        break
                    end
                end
            end
            if fl then self:notifyFlaregun(fl) end
        end)
    end

