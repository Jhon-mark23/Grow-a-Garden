                return false
            end
            return false
        end
        if not hasLiveCharacter() then
            wipeFullbrightConns()
            return false
        end
        getLightOrig()
        fullbrightOn = true
        rawset(_G, "__RakeFullbrightActive", true)
        setFullbrightValues()
        bindFullbrightSignals()
