    function auraIsStick(v)
        if not (v and v:IsA("Tool")) then return false end
        local n = string.lower(v.Name)
        return n == "stunstick" or (string.find(n, "stun", 1, true) and string.find(n, "stick", 1, true)) ~= nil
    end

    function auraGetRake()
        local rk = aura.rk
        if not (rk and rk.Parent) then
            rk = Workspace:FindFirstChild("Rake")
            aura.rk = rk
            aura.rr = nil
            aura.rh = nil
        end
        if not rk then return nil end
        local rh = aura.rh
        if not (rh and rh.Parent) then
            rh = rk:FindFirstChild("Monster") or rk:FindFirstChildWhichIsA("Humanoid")
            aura.rh = rh
        end
        if rh and rh.Health and rh.Health <= 0 then return nil end
        local rr = aura.rr
        if not (rr and rr.Parent) then
            rr = rk:FindFirstChild("HumanoidRootPart") or rk:FindFirstChild("HumanoidRootPart", true)
            aura.rr = rr
        end
        if not rr then return nil end
        return rk, rr, rh
    end

    function auraGetPart(rk, rr, pos)
        local best = rr
        local bd = rr and (rr.Position - pos).Magnitude or math.huge
        local names = { "Head", "Torso", "UpperTorso", "LowerTorso", "HumanoidRootPart" }
        for i = 1, #names do
            local v = rk:FindFirstChild(names[i])
            if v and v:IsA("BasePart") then
                local d = (v.Position - pos).Magnitude
                if d < bd then
                    best = v
                    bd = d
                end
            end
        end
        return best
    end

    function auraGetStick()
        local ch = LocalPlayer.Character
        if not ch then return nil end
        local s = aura.stick
        if not (s and s.Parent) then
            s = nil
            for _, v in ipairs(ch:GetChildren()) do
                if auraIsStick(v) then
                    s = v
                    break
                end
            end
            if not s then
                local bp = aura.bp
                if not (bp and bp.Parent) then
                    bp = LocalPlayer:FindFirstChild("Backpack") or nil
                    aura.bp = bp
                end
                if bp then
                    for _, v in ipairs(bp:GetChildren()) do
                        if auraIsStick(v) then
                            s = v
                            break
                        end
                    end
                end
                if s and st.rakeAuraAutoEquip == true then
                    local hum = ch:FindFirstChildWhichIsA("Humanoid")
                    if hum then
                        pcall(function() hum:EquipTool(s) end)
                    end
                    return nil
                end
            end
            aura.stick = s
            aura.ev = nil
            aura.hp = nil
        end
        if not (s and s.Parent == ch) then
            if s and st.rakeAuraAutoEquip == true then
                local hum = ch:FindFirstChildWhichIsA("Humanoid")
                if hum then
                    pcall(function() hum:EquipTool(s) end)
                end
                auraClearStick()
            end
            return nil
        end
        local ev = aura.ev
        if not (ev and ev.Parent) then
            ev = s:FindFirstChild("Event") or s:FindFirstChild("Event", true)
            aura.ev = ev
        end
        local hp = aura.hp
        if not (hp and hp.Parent) then
            hp = s:FindFirstChild("HitPart") or s:FindFirstChild("HitPart", true)
            aura.hp = hp
        end
        return s, ev, hp
    end

    function auraHasPower()
        local p = ReplicatedStorage:FindFirstChild("StationPower")
        if p and p.Value ~= true then return false end
        return true
    end

    function auraHasStamina()
        if st.infStamina == true then return true end
        local g = ReplicatedStorage:FindFirstChild("GSTMNA")
        if not g then return true end
        local ok, val = pcall(function() return g:Invoke() end)
        return not ok or not val or val >= 12
    end

    function auraTakeStamina()
        if st.infStamina == true then return end
        local tks = ReplicatedStorage:FindFirstChild("TKSMNA")
