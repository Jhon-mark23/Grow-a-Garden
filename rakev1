    -- ========== UPDATE FUNCTIONS ==========
    local UPDATE_INTERVAL = 0.5
    local OBJECT_SCAN_INTERVAL = 1.0

    local function updateObjectTargets()
        if not ESPConfig.Players.Enabled and 
           not ESPConfig.Rake.Enabled and 
           not ESPConfig.FlareGun.Enabled and 
           not ESPConfig.Scrap.Enabled and
           not ESPConfig.SupplyDrop.Enabled and
           not ESPConfig.RakeTrap.Enabled then
            return
        end
        
        if ESPConfig.Rake.Enabled then
            local rake = Workspace:FindFirstChild("Rake", true)
            if rake and not ESP.Highlights[rake] then
                ESP:AddESP(rake, "Rake", "RAKE")
            end
        end
        
        if ESPConfig.FlareGun.Enabled then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if isRealFlareGun(obj) and not ESP.Highlights[obj] then
                    ESP:AddESP(obj, "FlareGun", "FLARE GUN")
                end
            end
        end
        
        if ESPConfig.Scrap.Enabled then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if isCollectibleScrap(obj) then
                    if not ESP.Highlights[obj] then
                        ESP:AddESP(obj, "Scrap", "SCRAP")
                    end
                end
            end
        end

        if ESPConfig.SupplyDrop.Enabled then
            local root = getDropRoot()
            if root then
                for _, obj in ipairs(root:GetChildren()) do
                    if isSupplyDrop(obj) and not ESP.Highlights[obj] then
                        ESP:AddESP(obj, "SupplyDrop", "Supply Drop")
                    end
                end
            end
        end

        if ESPConfig.RakeTrap.Enabled then
            local root = getTrapRoot()
            if root then
                for _, obj in ipairs(root:GetChildren()) do
                    if isRakeTrap(obj) and not ESP.Highlights[obj] then
                        ESP:AddESP(obj, "RakeTrap", "Rake Trap")
                    end
                end
            end
        end
        
        local toRemove = {}
        for object, highlight in pairs(ESP.Highlights) do
            if not object:IsDescendantOf(Workspace) then
                table.insert(toRemove, object)
            else
                local isEnabled = false
                
                local player = Players:GetPlayerFromCharacter(object)
                if player and ESPConfig.Players.Enabled then
                    isEnabled = true
                end
                
                if not isEnabled and ESPConfig.Rake.Enabled then
                    local rake = Workspace:FindFirstChild("Rake", true)
                    if rake == object then
                        isEnabled = true
                    end
                end
                
                if not isEnabled and ESPConfig.FlareGun.Enabled and isRealFlareGun(object) then
                    isEnabled = true
                end
                
                if not isEnabled and ESPConfig.Scrap.Enabled and isCollectibleScrap(object) then
                    isEnabled = true
                end

                if not isEnabled and ESPConfig.SupplyDrop.Enabled and isSupplyDrop(object) then
                    isEnabled = true
                end

                if not isEnabled and ESPConfig.RakeTrap.Enabled and isRakeTrap(object) then
                    isEnabled = true
                end
                
                if not isEnabled then
                    table.insert(toRemove, object)
                end
            end
        end
        for _, object in ipairs(toRemove) do
            ESP:RemoveESP(object)
        end
    end

    local function updateAllText()
        for object, entry in pairs(ESP.TextEntries) do
            ESP:UpdateTextEntry(entry)
        end
        ESP:UpdateLocationText()
    end

    function ESP:UpdateLocationText()
        for _, markerEntry in ipairs(self.LocationMarkers) do
            if markerEntry.Marker and markerEntry.Marker.Parent then
                local pos = markerEntry.LocationData.Position
                local dist = self:getDistanceFromPlayer(pos)
                
                local text = markerEntry.LocationData.Name
                if dist and st.espShowDistance then
                    if dist >= 1000 then
                        text = string.format("%s | %.2f km", markerEntry.LocationData.Name, dist / 1000)
                    else
                        text = string.format("%s | %.0f m", markerEntry.LocationData.Name, dist)
                    end
                end
                
                markerEntry.Label.Text = text
            end
        end
    end

    -- ========== MAIN LOOP ==========
    local lastObjectScan = 0
    local lastTextUpdate = 0
    local heartbeatConnection

    local function updateLoop()
        local currentTime = tick()
        
        if currentTime - lastObjectScan >= OBJECT_SCAN_INTERVAL then
            updateObjectTargets()
            lastObjectScan = currentTime
        end
        
        if currentTime - lastTextUpdate >= UPDATE_INTERVAL then
            updateAllText()
            lastTextUpdate = currentTime
        end
    end

    function ESP:Start()
        if self.IsRunning then return end
        self.IsRunning = true
        heartbeatConnection = RunService.Heartbeat:Connect(updateLoop)
    end

    function ESP:Stop()
        if not self.IsRunning then return end
        self.IsRunning = false
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
            heartbeatConnection = nil
        end
    end

    -- ========== PLAYER HANDLING ==========
    local function handlePlayerCharacter(player, character)
        if player == LocalPlayer then return end
        if character and ESPConfig.Players.Enabled then
            if not ESP.Highlights[character] then
                ESP:AddESP(character, "Players", player.Name)
            end
        end
    end

    local function onPlayerAdded(player)
        if player == LocalPlayer then return end
        if player.Character then
            handlePlayerCharacter(player, player.Character)
        end
        
        local characterConn = player.CharacterAdded:Connect(function(character)
            handlePlayerCharacter(player, character)
        end)
        table.insert(ESP.Connections, characterConn)
        
        local removingConn = player.AncestryChanged:Connect(function(_, parent)
            if not parent then
                if player.Character then
                    ESP:RemoveESP(player.Character)
                end
                if characterConn then characterConn:Disconnect() end
                if removingConn then removingConn:Disconnect() end
            end
        end)
        table.insert(ESP.Connections, removingConn)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        onPlayerAdded(player)
    end

    local playerAddedConn = Players.PlayerAdded:Connect(onPlayerAdded)
    table.insert(ESP.Connections, playerAddedConn)

    local playerRemovingConn = Players.PlayerRemoving:Connect(function(player)
        if player.Character then
            ESP:RemoveESP(player.Character)
        end
    end)
    table.insert(ESP.Connections, playerRemovingConn)

    -- ========== FULLBRIGHT ==========
    local fullbrightOn = false
    local fullbrightApply = false
    local fullbrightConns = {}
    local fullbrightProps = {
        "Brightness", "ClockTime", "Ambient", "OutdoorAmbient",
        "FogStart", "FogEnd", "GlobalShadows", "ExposureCompensation"
    }
    local fullbrightVals = {
        Brightness = 4,
        ClockTime = 14,
        Ambient = Color3.new(1,1,1),
        OutdoorAmbient = Color3.new(1,1,1),
        FogStart = 0,
        FogEnd = 1e10,
        GlobalShadows = false,
        ExposureCompensation = -0.5,
    }
    local fullbrightSignalProps = {
        "Brightness", "ClockTime", "Ambient", "OutdoorAmbient",
        "FogStart", "FogEnd", "GlobalShadows"
    }

    function hasLiveCharacter()
        local ch = LocalPlayer.Character
        if not (ch and ch.Parent) then return false end
        local hum = ch:FindFirstChild("Humanoid")
        return hum ~= nil and hum.Parent ~= nil
    end

    function getLightOrig()
        local store = rawget(_G, "__RakeLightingOriginals")
        if type(store) ~= "table" then
            store = {}
            rawset(_G, "__RakeLightingOriginals", store)
        end
        for _, prop in fullbrightProps do
            if store[prop] == nil then
                pcall(function() store[prop] = Lighting[prop] end)
            end
        end
        return store
    end

    function setFullbrightValues()
        if fullbrightApply == true or not hasLiveCharacter() then return false end
        fullbrightApply = true
        local ok = pcall(function()
            for prop, val in fullbrightVals do
                if Lighting[prop] ~= val then
                    Lighting[prop] = val
                end
            end
        end)
        fullbrightApply = false
        return ok
    end

    function wipeFullbrightConns()
        for i = #fullbrightConns, 1, -1 do
            local c = fullbrightConns[i]
            if c then
                pcall(function() c:Disconnect() end)
            end
            fullbrightConns[i] = nil
        end
    end

    function bindFullbrightSignals()
        wipeFullbrightConns()
        if st.fullbright ~= true or not hasLiveCharacter() then return false end
        for _, prop in fullbrightSignalProps do
            local val = fullbrightVals[prop]
            local ok, con = pcall(function()
                return Lighting:GetPropertyChangedSignal(prop):Connect(function()
                    if st.fullbright ~= true or fullbrightApply == true or not hasLiveCharacter() then
                        return
                    end
                    if Lighting[prop] ~= val then
                        fullbrightApply = true
                        pcall(function()
                            if Lighting[prop] ~= val then
                                Lighting[prop] = val
                            end
                        end)
                        fullbrightApply = false
                    end
                end)
            end)
            if ok and con then
                fullbrightConns[#fullbrightConns + 1] = con
            end
        end
        return true
    end

    function applyFullbright()
        if st.fullbright ~= true then
            if fullbrightOn == true or rawget(_G, "__RakeFullbrightActive") == true then
                fullbrightOn = false
                rawset(_G, "__RakeFullbrightActive", false)
                wipeFullbrightConns()
                local store = rawget(_G, "__RakeLightingOriginals")
                if type(store) == "table" then
