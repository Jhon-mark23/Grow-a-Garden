    local thirdPersonActive = false
    local thirdPersonConns = {}
    function applyThirdPerson(force)
        if st.unlockThirdPerson ~= true and force ~= true then
            if thirdPersonActive then
                thirdPersonActive = false
                for _, c in thirdPersonConns do
                    pcall(function() c:Disconnect() end)
                end
                thirdPersonConns = {}
            end
            return
        end
        thirdPersonActive = true
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam then
                cam.CameraType = Enum.CameraType.Custom
                local char = getChar()
                if char then
                    local hum = ffc(char, "Humanoid")
                    if hum then
                        cam.CameraSubject = hum
                    end
                end
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end
            local function enforce()
                if st.unlockThirdPerson then
                    local currentCam = workspace.CurrentCamera
                    if currentCam then
                        currentCam.CameraType = Enum.CameraType.Custom
                        local char = getChar()
                        if char then
                            local hum = ffc(char, "Humanoid")
                            if hum then
                                currentCam.CameraSubject = hum
                            end
                        end
                    end
                end
            end
            local con1 = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(enforce)
            table.insert(thirdPersonConns, con1)
            local lp = Plrs.LocalPlayer
            if lp then
                local con2 = lp.CharacterAdded:Connect(function()
                    task.wait(0.1)
                    enforce()
                end)
                table.insert(thirdPersonConns, con2)
            end
            local con3 = Run.Heartbeat:Connect(function()
                if st.unlockThirdPerson then
                    enforce()
                end
            end)
            table.insert(thirdPersonConns, con3)
        end)
    end

