    function bringFlaregun()
        local head = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
        if not head then
            notify("Error", "Character or Head not found!", 2)
            return false
        end
        
        local flaregun = nil
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if isRealFlareGun(obj) then
                flaregun = obj
                break
            end
        end
        
        if not flaregun then
            notify("Flaregun", "No flaregun found!", 2)
            return false
        end
        
        local success = false
        pcall(function()
            local targetPart = flaregun
            if flaregun:IsA("Model") then
                local primary = flaregun.PrimaryPart
                if not primary then
                    primary = flaregun:FindFirstChildWhichIsA("BasePart")
                end
                if primary then
                    targetPart = primary
                end
            end
            
            if targetPart and targetPart:IsA("BasePart") then
                -- Spawn above head like scrap does
                local newPos = head.Position + Vector3.new(0, 2, 0)
                targetPart.CFrame = CFrame.new(newPos)
                targetPart.AssemblyLinearVelocity = Vector3.zero
                targetPart.AssemblyAngularVelocity = Vector3.zero
                
                if flaregun:IsA("Model") then
                    local offset = targetPart.CFrame - flaregun:GetPivot()
                    flaregun:PivotTo(CFrame.new(newPos) * offset)
                end
                success = true
            end
        end)
        
        if success then
            notify("✅ Flaregun", "Brought flaregun to you!", 2)
            return true
