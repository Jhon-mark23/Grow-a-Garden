            local c = fullbrightConns[i]
            if c then
                pcall(function() c:Disconnect() end)
            end
            fullbrightConns[i] = nil
        end
    end

    function bindFullbrightSignals()
        wipeFullbrightConns()
        if st.fullbright ~= true or not hasLiveCharacter() then return false end
        for _, prop in fullbrightSignalProps do
            local val = fullbrightVals[prop]
            local ok, con = pcall(function()
                return Lit:GetPropertyChangedSignal(prop):Connect(function()
                    if st.fullbright ~= true or fullbrightApply == true or not hasLiveCharacter() then
                        return
                    end
                    if Lit[prop] ~= val then
                        fullbrightApply = true
                        pcall(function()
                            if Lit[prop] ~= val then
                                Lit[prop] = val
                            end
                        end)
                        fullbrightApply = false
                    end
                end)
            end)
            if ok and con then
                fullbrightConns[#fullbrightConns + 1] = con
            end
        end
        return true
    end

    function applyFullbright()
        if st.fullbright ~= true then
            if fullbrightOn == true or rawget(_G, "__RakeFullbrightActive") == true then
                fullbrightOn = false
                rawset(_G, "__RakeFullbrightActive", false)
                wipeFullbrightConns()
                local store = rawget(_G, "__RakeLightingOriginals")
                if type(store) == "table" then
                    pcall(function()
                        for _, prop in fullbrightProps do
                            if store[prop] ~= nil and Lit[prop] ~= store[prop] then
                                Lit[prop] = store[prop]
                            end
                        end
                    end)
