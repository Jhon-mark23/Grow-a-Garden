            local fl = ffcr(Ws, "FlareGunPickUp")
            if not fl then
                for _, obj in desc(Ws) do
                    if obj:IsA("BasePart") and obj.Name:lower():find("flaregun") then
                        fl = obj
                        break
                    end
                end
            end
            if fl then self:notifyFlaregun(fl) end
        end)
