                self.TextEntries[object].Connection:Disconnect()
            end
            if self.TextEntries[object].Gui then
                self.TextEntries[object].Gui:Destroy()
            end
            self.TextEntries[object] = nil
        end
    end

    function ESP:RemoveESP(object)
        self:RemoveHighlight(object)
        self:RemoveText(object)
    end

    function ESP:CreateHighlight(object, configKey)
        self:RemoveHighlight(object)
        local settings = ESPConfig[configKey]
        if not settings then return nil end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.Adornee = object
        highlight.FillColor = settings.FillColor
        highlight.FillTransparency = settings.FillTransparency
        highlight.OutlineColor = settings.OutlineColor
        highlight.OutlineTransparency = settings.OutlineTransparency
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = object
        self.Highlights[object] = highlight
        return highlight
    end

    function ESP:CreateText(object, configKey, displayName)
        self:RemoveText(object)
        local part = self:getAttachPart(object)
        if not part then return nil end
        
        local settings = ESPConfig[configKey]
        if not settings then return nil end

        local gui = Instance.new("BillboardGui")
        gui.Name = "ESPText"
        gui.Adornee = part
        gui.Parent = part
        gui.Size = UDim2.new(0, 200, 0, 30)
        gui.StudsOffset = Vector3.new(0, 3, 0)
        gui.AlwaysOnTop = true
        gui.MaxDistance = math.huge
        gui.ResetOnSpawn = false
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

        local label = Instance.new("TextLabel")
        label.Parent = gui
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = displayName
        label.TextColor3 = settings.TextColor
        label.TextStrokeTransparency = 0.3
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Font = Enum.Font.SourceSansBold
        label.TextSize = st.espTextSize or 12
        label.TextWrapped = true

        local entry = {
            Object = object,
            Part = part,
            Gui = gui,
            Label = label,
            ConfigKey = configKey,
            DisplayName = displayName
        }

        local connection
        connection = object.AncestryChanged:Connect(function(_, parent)
            if not parent then
                self:RemoveESP(object)
                if connection then connection:Disconnect() end
            end
        end)
        entry.Connection = connection
        self.TextEntries[object] = entry
        return entry
    end

    function ESP:getAttachPart(object)
        if object:IsA("BasePart") then return object end
        if object:IsA("Model") then
            local part = object:FindFirstChild("HumanoidRootPart")
            if part then return part end
            part = object:FindFirstChild("Head")
            if part then return part end
            part = object:FindFirstChild("Torso")
            if part then return part end
            part = object:FindFirstChildWhichIsA("BasePart")
            if part then return part end
            return object.PrimaryPart
        end
        return nil
    end

    function ESP:AddESP(object, configKey, displayName)
        if not object then return end
        self:CreateHighlight(object, configKey)
        self:CreateText(object, configKey, displayName)
    end

    function ESP:UpdateTextEntry(entry)
        if not entry or not entry.Object or not entry.Gui then return end
        if not entry.Object:IsDescendantOf(Workspace) then
            self:RemoveESP(entry.Object)
            return
        end
        
        local pos = self:getObjectPosition(entry.Object)
        local dist = self:getDistanceFromPlayer(pos)
        
        local text = entry.DisplayName
        if dist and st.espShowDistance then
            if dist >= 1000 then
                text = string.format("%s | %.2f km", entry.DisplayName, dist / 1000)
            else
                text = string.format("%s | %.0f m", entry.DisplayName, dist)
            end
        end
        
        entry.Label.Text = text
    end

    function ESP:getObjectPosition(object)
        if object:IsA("BasePart") then return object.Position end
        if object:IsA("Model") then
            local part = self:getAttachPart(object)
            if part then return part.Position end
            return object:GetPivot().Position
        end
        return Vector3.new(0, 0, 0)
    end

    function ESP:getDistanceFromPlayer(position)
        if not LocalPlayer.Character then return nil end
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        return (root.Position - position).Magnitude
    end

