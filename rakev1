            auraT = auraT + dt
            pcall(function()
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local rk, rr = auraGetRake()
                if not (rk and rr) then return end
                local range = math.clamp(tonumber(st.rakeAuraRange) or 12, 6, 30)
                if (rr.Position - root.Position).Magnitude > range then return end
                local stick, ev, hp = auraGetStick()
                if not (stick and ev) then return end
                local hit = auraGetPart(rk, rr, root.Position)
                if not hit or (hit.Position - root.Position).Magnitude > range then return end
                auraPrepHitpart(hp)
                local delay = math.clamp(tonumber(st.rakeAuraDelay) or 0.12, 0.05, 0.6)
                if auraT >= delay and auraHasPower() and auraHasStamina() then
                    auraT = 0
                    auraSwing(ev, hit)
                end
            end)
        else
            auraT = 0
        end

        -- Auto heal
        pcall(autoFirstAid)

        -- WalkSpeed
        if st.walkspeedOn then applyWalkSpeed() end

        -- Info Bubble updates
