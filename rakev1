                        for _, prop in fullbrightProps do
                            if store[prop] ~= nil and Lighting[prop] ~= store[prop] then
                                Lighting[prop] = store[prop]
                            end
                        end
                    end)
                end
                return false
            end
            return false
        end
        if not hasLiveCharacter() then
            wipeFullbrightConns()
            return false
        end
        getLightOrig()
        fullbrightOn = true
        rawset(_G, "__RakeFullbrightActive", true)
        setFullbrightValues()
        bindFullbrightSignals()
        return true
    end

