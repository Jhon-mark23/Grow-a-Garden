    local SpawnNotifier = {
        notifiedScraps = {},
        notifiedFlareguns = {},
        active = true,
        lastNotification = 0,
        cooldown = 2,
    }
    function SpawnNotifier:notifyScrap(scrap)
        if not self.active then return end
        local id = tostring(scrap)
        if self.notifiedScraps[id] then return end
        if time() - self.lastNotification < self.cooldown then
            task.wait(self.cooldown - (time() - self.lastNotification))
        end
        self.notifiedScraps[id] = true
        self.lastNotification = time()
        notify("🔧 Scrap Spawned!", "A scrap has appeared!", 3)
        task.delay(60, function() self.notifiedScraps[id] = nil end)
    end
    function SpawnNotifier:notifyFlaregun(flaregun)
        if not self.active then return end
        local id = tostring(flaregun)
        if self.notifiedFlareguns[id] then return end
        if time() - self.lastNotification < self.cooldown then
            task.wait(self.cooldown - (time() - self.lastNotification))
        end
        self.notifiedFlareguns[id] = true
        self.lastNotification = time()
        notify("🔫 Flaregun Spawned!", "A flaregun has appeared!", 3)
        task.delay(60, function() self.notifiedFlareguns[id] = nil end)
    end
    function SpawnNotifier:startListening()
        bind(Ws.DescendantAdded, function(obj)
            if obj.Name == "Scrap" and obj:IsA("BasePart") then
                self:notifyScrap(obj)
            end
            if obj.Name == "FlareGunPickUp" or (obj.Name:lower():find("flaregun") and obj:IsA("BasePart")) then
                self:notifyFlaregun(obj)
            end
        end)
        task.delay(2, function()
            local filter = ffc(Ws, "Filter")
            local scrapRoot = filter and ffc(filter, "ScrapSpawns")
