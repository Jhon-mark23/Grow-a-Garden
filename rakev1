    -- ========== DETECTION ==========
    local function getScrapRoot()
        local filter = Workspace:FindFirstChild("Filter")
        return filter and filter:FindFirstChild("ScrapSpawns") or nil
    end

    local function isCollectibleScrap(obj)
        if not obj then return false end
        if not obj:IsA("BasePart") then return false end
        if obj.Name ~= "Scrap" then return false end
        
        local parent = obj.Parent
        while parent do
            if parent.Name == "Box" and parent:IsA("Model") then
                return false
            end
            parent = parent.Parent
        end
        
        local root = getScrapRoot()
        if root and obj:IsDescendantOf(root) then
            return true
        end
        
        return false
    end

    local function isRealFlareGun(obj)
        if not obj then return false end
        if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false end
        
        local name = obj.Name
        if name == "FlareGunPickUp" then
            if obj:IsA("BasePart") then
                if obj.Size.Magnitude > 1 then
                    return true
                end
            elseif obj:IsA("Model") then
                local parts = obj:GetChildren()
                if #parts > 2 then
                    return true
                end
            end
            return true
        end
        
        return false
    end

    local function isSupplyDrop(obj)
        return obj and obj.Name == "Box" and obj:IsA("Model")
    end

    local function isRakeTrap(obj)
        return obj and obj.Name == "RakeTrapModel" and obj:IsA("Model")
    end

    local function getDropRoot()
        local debris = Workspace:FindFirstChild("Debris")
        if not debris then return nil end
        return debris:FindFirstChild("SupplyCrates") or debris:FindFirstChild("SupplyCreates")
    end

    local function getTrapRoot()
        local debris = Workspace:FindFirstChild("Debris")
        return debris and debris:FindFirstChild("Traps") or nil
    end

