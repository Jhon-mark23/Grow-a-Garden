            if isCollectibleScrap(obj) and not isInCharacter(obj) then
                pcall(function()
                    obj.CFrame = head.CFrame * CFrame.new(0, 0.5 + (count * 0.5), 0)
                    obj.AssemblyLinearVelocity = Vector3.zero
                    obj.AssemblyAngularVelocity = Vector3.zero
