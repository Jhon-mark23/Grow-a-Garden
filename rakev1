    -- Respawn handler
    local function onRespawn()
        if st.unlockThirdPerson then
            task.wait(0.5)
            applyThirdPerson(true)
        end
        if st.fullbright then applyFullbright() end
        if st.infStamina then applyInfTabs() end
        if st.noFall then applyNoFall() end
        if st.fovOn then applyFov() end
        if st.walkspeedOn then
            task.wait(0.1)
            applyWalkSpeed()
        end
        if st.infoBubble then syncBubble() end
        applyZoom()
        task.wait(0.3)
        espScan()
    end
    local lp = Plrs.LocalPlayer
    if lp then bind(lp.CharacterAdded, onRespawn) end

    -- Main update loop (ESP refresh every st.espScan seconds)
    local espTimer = 0
    bind(Run.Heartbeat, function(dt)
        if not AllowRunService then return end

        -- ESP updates - scan and update positions
        if espAny() then
            espTimer = espTimer + dt
            if espTimer >= (st.espScan or 2.0) then
                espTimer = 0
                espScan()
            end

            -- Update Player ESP positions
            for p, it in pairs(esp.players) do
                if it and it.o and it.o.Parent then
                    local ch = it.o
                    local head = ch and ffcr(ch, "Head")
                    local pos = espPosOf(head or ch)
                    if pos then
                        espShow(it.d, pos, p.Name)
                    else
                        if it.d then it.d.Visible = false end
                    end
                else
                    if it and it.d then it.d.Visible = false end
                end
            end

            -- Update Flare Gun ESP
            if esp.flare and esp.flare.o and esp.flare.o.Parent then
                local fl = esp.flare.o
                local part = fl and (ffcr(fl, "FlareGun") or fl)
                local pos = espPosOf(part or fl)
                if pos then
                    espShow(esp.flare.d, pos, "Flare Gun")
                else
                    if esp.flare.d then esp.flare.d.Visible = false end
                end
            elseif esp.flare and esp.flare.d then
                esp.flare.d.Visible = false
            end

            -- Update Location ESP
            if st.locEsp then
                for _, loc in ipairs(LocationData) do
                    local d = esp.locs[loc.Name]
                    if d then
                        espShow(d, loc.Position, "[LOC] "..loc.Name)
                    end
                end
            end
        end

        -- Infinite stamina
        if st.infStamina then
            infSys.fast = infSys.fast + dt
            if infSys.fast >= 0.75 then
                infSys.fast = 0
                applyInfTabs()
            end
        end

        -- Killaura
        if st.rakeAura then
            auraT = auraT + dt
            pcall(function()
                local root = GET_HRP()
                if not root then return end
                local rk, rr = auraGetRake()
                if not (rk and rr) then return end
                local range = math.clamp(tonumber(st.rakeAuraRange) or 12, 6, 30)
                if (rr.Position - root.Position).Magnitude > range then return end
                local stick, ev, hp = auraGetStick()
                if not (stick and ev) then return end
                local hit = auraGetPart(rk, rr, root.Position)
                if not hit or (hit.Position - root.Position).Magnitude > range then return end
                auraPrepHitpart(hp)
                local delay = math.clamp(tonumber(st.rakeAuraDelay) or 0.12, 0.05, 0.6)
                if auraT >= delay and auraHasPower() and auraHasStamina() then
                    auraT = 0
                    auraSwing(ev, hit)
                end
            end)
        else
            auraT = 0
        end

        -- Auto heal
        pcall(autoFirstAid)

        -- WalkSpeed
        if st.walkspeedOn then applyWalkSpeed() end

        -- Info Bubble updates
        if st.infoBubble then
            pcall(function()
                local rk = ffcr(Ws, "Rake")
                local tv = ffcr(rk, "TargetVal")
                local val = tv and tv.Value
                if val and val.Parent then
                    setInfoTarget("Rake's Target: " .. tostring(val.Parent))
                else
                    setInfoTarget("Rake's Target: none")
                end
            end)
            pcall(function()
                local sec = fmtTime(valOf(ffc(Rep, "Timer"), 0))
                if valOf(ffc(Rep, "Night"), false) == true then
                    setInfoTime("Time Until Day: " .. sec)
                else
                    setInfoTime("Time Until Night: " .. sec)
                end
            end)
            pcall(function()
                local powerValues = ffc(Rep, "PowerValues")
                local powerLevel = valOf(powerValues and ffc(powerValues, "PowerLevel"), 1000)
                setInfoPower("Power: " .. fmtPower(powerLevel) .. "%")
            end)
        end
    end)

