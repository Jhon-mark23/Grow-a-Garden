        if st.rakeAura == true then
            auraT = auraT + dt
            pcall(function()
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local rk, rr = auraGetRake()
                if not (rk and rr) then return end
                local range = math.clamp(tonumber(st.rakeAuraRange) or 12, 6, 30)
                if (rr.Position - root.Position).Magnitude > range then return end
                local stick, ev, hp = auraGetStick()
                if not (stick and ev) then return end
                local hit = auraGetPart(rk, rr, root.Position)
                if not hit or (hit.Position - root.Position).Magnitude > range then return end
                auraPrepHitpart(hp)
                local delay = math.clamp(tonumber(st.rakeAuraDelay) or 0.12, 0.05, 0.6)
                if auraT >= delay and auraHasPower() and auraHasStamina() then
                    auraT = 0
                    auraSwing(ev, hit)
                end
            end)
        else
            auraT = 0
        end

        -- Info Bubble updates
        if st.infoBubble then
            pcall(function()
                local rk = Workspace:FindFirstChild("Rake", true)
                local tv = rk and rk:FindFirstChild("TargetVal")
                local val = tv and tv.Value
                if val and val.Parent then
                    setInfoTarget("Rake's Target: " .. tostring(val.Parent))
                else
                    setInfoTarget("Rake's Target: none")
                end
            end)
            pcall(function()
                local timer = ReplicatedStorage:FindFirstChild("Timer")
                local night = ReplicatedStorage:FindFirstChild("Night")
                local sec = fmtTime(timer and timer.Value or 0)
                if night and night.Value == true then
                    setInfoTime("Time Until Day: " .. sec)
                else
                    setInfoTime("Time Until Night: " .. sec)
                end
            end)
            pcall(function()
                local powerValues = ReplicatedStorage:FindFirstChild("PowerValues")
                local powerLevel = powerValues and powerValues:FindFirstChild("PowerLevel")
                setInfoPower("Power: " .. fmtPower(powerLevel and powerLevel.Value or 1000) .. "%")
            end)
        end
    end)

    -- Final loaded notification
    task.delay(1.5, function()
        notify("✅ Loaded", SCRIPT_NAME .. " " .. SCRIPT_VERSION .. " with Kill Aura", 3, true)
        print("✅ " .. SCRIPT_NAME .. " " .. SCRIPT_VERSION .. " with Kill Aura loaded.")
    end)
end