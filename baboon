----------------------------------------------------------------
-- ESP SYSTEM
----------------------------------------------------------------
local espEnabled = false
local guiTags = {}

local function createESP(player)
    if player == LocalPlayer or not player.Character then return end
    local head = player.Character:FindFirstChild("Head")
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not head or not hum then return end
    if guiTags[player] then return end

    local gui = Instance.new("BillboardGui")
    gui.Size = UDim2.new(0,120,0,28)
    gui.StudsOffset = Vector3.new(0,2,0)
    gui.Adornee = head
    gui.AlwaysOnTop = true
    gui.Parent = head

    local label = Instance.new("TextLabel", gui)
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255,50,50)
    label.TextScaled = true

    guiTags[player] = {gui=gui,label=label,hum=hum}
end

local function removeESP(player)
    if guiTags[player] then
        guiTags[player].gui:Destroy()
        guiTags[player] = nil
    end
end

ESPTab:CreateToggle({
    Name = "Player ESP (Name + HP)",
    CurrentValue = false,
    Callback = function(state)
        espEnabled = state
        for _, p in pairs(Players:GetPlayers()) do
            if state then createESP(p) else removeESP(p) end
        end
    end,
})

RunService.RenderStepped:Connect(function()
    for plr, data in pairs(guiTags) do
        if data.label and data.hum then
            data.label.Text = plr.Name.." | HP: "..math.floor(data.hum.Health)
        end
    end
end)

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(1)
        if espEnabled then createESP(p) end
    end)
end)

----------------------------------------------------------------
-- AUTO AFK FLOAT / SKY + ANTI AFK
----------------------------------------------------------------

local VirtualUser = game:GetService("VirtualUser")

local afkFloating = false
local skyHeight = 400
local floatVelocity

------------------------------------------------------------------------
-- UI TOGGLE
------------------------------------------------------------------------

OthersTab:CreateToggle({
    Name = "AFK MODE (FLY IN SKY AFK)",
    CurrentValue = false,
    Callback = function(state)
        afkFloating = state

        local char = LocalPlayer.Character
        if not char then return end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if state then
            -- Create floating force
            floatVelocity = Instance.new("BodyVelocity")
            floatVelocity.MaxForce = Vector3.new(1e5,1e5,1e5)
            floatVelocity.Velocity = Vector3.new(0,0,0)
            floatVelocity.P = 1e4
            floatVelocity.Parent = hrp

            -- Move player into the sky
            hrp.CFrame = CFrame.new(
                hrp.Position.X,
                skyHeight,
                hrp.Position.Z
            )

            -- Notify
            Rayfield:Notify({
                Title = "AFK MODE",
                Content = "✅ Floating in sky + Anti AFK enabled",
                Duration = 4
            })
        else
            if floatVelocity then
                floatVelocity:Destroy()
                floatVelocity = nil
            end

            Rayfield:Notify({
                Title = "AFK MODE",
                Content = "❌ AFK Float Disabled",
                Duration = 4
            })
        end
    end
})

------------------------------------------------------------------------
-- KEEP PLAYER FLOATING
------------------------------------------------------------------------

RunService.RenderStepped:Connect(function()
    if afkFloating and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = CFrame.new(
                hrp.Position.X,
                skyHeight,
                hrp.Position.Z
            )
        end
    end
end)

------------------------------------------------------------------------
-- ANTI AFK PROTECTION
------------------------------------------------------------------------

LocalPlayer.Idled:Connect(function()
    if afkFloating then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)

----------------------------------------------------------------
-- TELEPORT SYSTEM (TORSO)
----------------------------------------------------------------
local selectedPlayer = nil
local autoTeleport = false
local autoRandomTP = false

local function getPlayerNames()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(list,p.Name) end
    end
    table.sort(list)
    return list
end

local dropdown = TeleportTab:CreateDropdown({
    Name = "Select Player",
    Options = getPlayerNames(),
    CurrentOption = {},
    Callback = function(option)
        selectedPlayer = option[1]
    end
})

Players.PlayerAdded:Connect(function() dropdown:Refresh(getPlayerNames()) end)
Players.PlayerRemoving:Connect(function() dropdown:Refresh(getPlayerNames()) end)

-- Teleport selected player
TeleportTab:CreateButton({
    Name = "Teleport to Selected Player",
    Callback = function()
        if not selectedPlayer then
            Rayfield:Notify({Title="Teleport", Content="Select a player!", Duration=3})
            return
        end
        local target = Players:FindFirstChild(selectedPlayer)
        local myChar = LocalPlayer.Character
        if not target or not target.Character or not myChar then return end
        local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if not targetHRP or not myHRP then return end
        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0,3,0)
        Rayfield:Notify({Title="Teleported", Content="Teleported to "..target.Name.." torso", Duration=3})
    end
})

-- Teleport random player
TeleportTab:CreateButton({
    Name = "Teleport to RANDOM Player (TORSO)",
    Callback = function()
        local targets = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(targets,p)
            end
        end
        if #targets==0 then
            Rayfield:Notify({Title="Teleport", Content="No valid targets found", Duration=3})
            return
        end
        local target = targets[math.random(#targets)]
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        myHRP.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0,3,0)
        Rayfield:Notify({Title="Teleported", Content="Random torso TP: "..target.Name, Duration=3})
    end
})

-- Auto teleport follow selected player
TeleportTab:CreateToggle({
    Name = "Auto Teleport Follow (TORSO)",
    CurrentValue = false,
    Callback = function(state)
        autoTeleport = state
        if autoTeleport and not selectedPlayer then
            Rayfield:Notify({Title="Auto Teleport", Content="Select a player first!", Duration=4})
            autoTeleport = false
        end
    end
})

-- Auto teleport random
TeleportTab:CreateToggle({
    Name = "Auto Teleport RANDOM Player",
    CurrentValue = false,
    Callback = function(state)
        autoRandomTP = state
    end
})

-- FOLLOW & RANDOM TELEPORT LOOP
RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    -- Auto follow selected player
    if autoTeleport and selectedPlayer then
        local target = Players:FindFirstChild(selectedPlayer)
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            myHRP.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0,3,0)
        end
    end

    -- Auto random teleport
    if autoRandomTP then
        local targets = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(targets,p)
            end
        end
        if #targets>0 then
            local target = targets[math.random(#targets)]
            myHRP.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0,3,0)
        end
    end
end)

